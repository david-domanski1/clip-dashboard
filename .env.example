# Clip Dashboard credentials. The app stores these in data/secrets.json (gitignored) when you enter them
# on the Setup page. You can also set them as environment variables with these names (upper-case).
# Never commit real values; the repository must stay free of credentials.

# YouTube direct route: contents of the OAuth "Desktop app" client JSON from Google Cloud Console.
YOUTUBE_CLIENT_SECRET={"installed":{"client_id":"...","client_secret":"...","redirect_uris":["http://localhost"]}}

# TikTok direct route: from developers.tiktok.com (app platform: Desktop, redirect http://127.0.0.1:8765/oauth/callback/tiktok/)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# Instagram direct route: Meta app of type Business with Facebook Login for Business
# (redirect http://localhost:8765/oauth/callback/instagram/)
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Posting service route (Zernio): API key from zernio.com → dashboard → API keys
SERVICE_API_KEY=

# Optional runtime settings
# CLIPDASH_DATA=/path/to/data      # where the database, cache, clips and secrets live (default: ./data)
# CLIPDASH_PORT=8765
# CLIPDASH_DRY_RUN=1               # publishers simulate success and never contact a platform
